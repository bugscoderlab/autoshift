# Database Configuration (TiDB / MySQL-compatible)
# For TiDB Cloud, use your TiDB Cloud host (e.g., gateway01.us-east-1.prod.aws.tidbcloud.com)
DB_HOST=localhost
DB_PORT=4000
DB_NAME=hospital_roster
DB_USER=root
DB_PASSWORD=

# Force SSL (set to True for TiDB Cloud or if SSL is required)
# SSL is automatically enabled when TiDB Cloud host patterns are detected
DB_FORCE_SSL=False

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=True

# AI Configuration - Claude (Primary)
CLAUDE_API_KEY=
CLAUDE_API_BASE_URL=https://api.anthropic.com

# AI Configuration - Groq (Fast Inference)
GROQ_API_KEY=your_groq_api_key
GROQ_API_BASE_URL=https://api.groq.com

# AI Parameters
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.2

# Logging
LOG_PATH=./logs
LOG_LEVEL=INFO

# Application Environment
ENVIRONMENT=development

# JWT Secret (for future auth)
JWT_SECRET=your_jwt_secret_key

# TiDB Cloud Configuration Example:
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=hospital_roster
# DB_USER=root
# DB_PASSWORD=your_tidb_cloud_password
# DB_FORCE_SSL=True



